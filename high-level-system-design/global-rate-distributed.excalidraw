    {
      "id": "kQJQH4vUyo_n32WcPUgQO",
      "type": "text",
      "x": 4384.369400748978,
      "y": 3132.924366501885,
      "width": 472.47955322265625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "IuVs6i0u9gV805gzwa178"
      ],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 900673515,
      "version": 371,
      "versionNonce": 2044788389,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789490237705,
      "created": 1789489358319,
      "link": null,
      "locked": false,
      "text": "CHOICE A\nToken Bucket\nPro\n- allows traffic bursts (up to bucket capacity)\n- memory efficient (2 variables: tokens, last_updated)\n\nCons\nRace conditions in distributed system require lock mechanism",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE A\nToken Bucket\nPro\n- allows traffic bursts (up to bucket capacity)\n- memory efficient (2 variables: tokens, last_updated)\n\nCons\nRace conditions in distributed system require lock mechanism",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "E9ti40PaXbVFT8IrcQRmf",
      "type": "text",
      "x": 4384.369400748978,
      "y": 3302.082096333506,
      "width": 392.49566650390625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "IuVs6i0u9gV805gzwa178"
      ],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 1077766533,
      "version": 142,
      "versionNonce": 1425269253,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789490237705,
      "created": 1789489836552,
      "link": null,
      "locked": false,
      "text": "Best Fit for general API rate limiting where short\nbursts are acceptable",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Best Fit for general API rate limiting where short\nbursts are acceptable",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ulOe7o5KGF2lGeCBjyqyO",
      "type": "text",
      "x": 4383.4926080768155,
      "y": 3405.266697115941,
      "width": 584.447509765625,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "Ch6o34eDB-gF_z6Zn5Kt-"
      ],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1268292235,
      "version": 668,
      "versionNonce": 1658193925,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789490235781,
      "created": 1789489466432,
      "link": null,
      "locked": false,
      "text": "CHOICE B\nLeaky Bucket\nPro\n- Smooths out traffic spikes\n- processes requests at a constant unifrm rate (great for egress traffic)\n\nCons\n- Can drop legitimate requests during temporary spikes if the queue fills up\n- adds queue delay",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE B\nLeaky Bucket\nPro\n- Smooths out traffic spikes\n- processes requests at a constant unifrm rate (great for egress traffic)\n\nCons\n- Can drop legitimate requests during temporary spikes if the queue fills up\n- adds queue delay",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "3zqJ3N1epBS6jEaESDrLw",
      "type": "text",
      "x": 4383.4926080768155,
      "y": 3591.348003981885,
      "width": 620.1434326171875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "ZWeqvAIhHMDjMbguwypts",
        "Ch6o34eDB-gF_z6Zn5Kt-"
      ],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 1836227269,
      "version": 312,
      "versionNonce": 1631633253,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789490235781,
      "created": 1789489886714,
      "link": null,
      "locked": false,
      "text": "Better suited for background processing queues rather than synchronous APIs",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Better suited for background processing queues rather than synchronous APIs",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NAo19EoFxeNfblbaPoqWJ",
      "type": "text",
      "x": 4377.660770569441,
      "y": 3648.6824457513685,
      "width": 470.17559814453125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "L5NEUhlchaKTSwdjNOhhH"
      ],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 1061669259,
      "version": 1018,
      "versionNonce": 1242745509,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789490233820,
      "created": 1789489551070,
      "link": null,
      "locked": false,
      "text": "CHOICE C\nFixed Window Counter\nPro\n- Extremely memory efficient\n- simple to implement (INCR with TTL in Redis)\n\nCons\n- Boundary Problem: can pass through at window boundaries\n(100 reqs at 11:59 and 100 at 12:00)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE C\nFixed Window Counter\nPro\n- Extremely memory efficient\n- simple to implement (INCR with TTL in Redis)\n\nCons\n- Boundary Problem: can pass through at window boundaries\n(100 reqs at 11:59 and 100 at 12:00)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mMQnshGRAyQ1YKNKEHGYd",
      "type": "text",
      "x": 4377.660770569441,
      "y": 3841.792185010377,
      "width": 337.05572509765625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "w43yMiO63sHIBYXPgExQC",
        "L5NEUhlchaKTSwdjNOhhH"
      ],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 1605959851,
      "version": 252,
      "versionNonce": 1426861573,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789490233820,
      "created": 1789489924531,
      "link": null,
      "locked": false,
      "text": "Too inaccurate for strict limit enforcement",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Too inaccurate for strict limit enforcement",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IzP819YnPljF6eBsBa55n",
      "type": "text",
      "x": 4371.446104557487,
      "y": 3905.407065578403,
      "width": 533.4395141601562,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "Lji4QI4REDld1Y9NOhuRf"
      ],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 1518187627,
      "version": 1286,
      "versionNonce": 1368654277,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789490231366,
      "created": 1789489700970,
      "link": null,
      "locked": false,
      "text": "CHOICE D\nSliding Window Counter\nPro\n- On top of FWC with weighted averages\n- Highly accurate\n- memory efficient (2 counters per key)\n\nCons\n- Minor approximation edge cases (assumes uniform distribution over\npervious window)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE D\nSliding Window Counter\nPro\n- On top of FWC with weighted averages\n- Highly accurate\n- memory efficient (2 counters per key)\n\nCons\n- Minor approximation edge cases (assumes uniform distribution over\npervious window)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FADR4CXtZXI2Gtu6HCSdM",
      "type": "text",
      "x": 4371.446104557487,
      "y": 4121.4390341097815,
      "width": 429.6476135253906,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "jZP4tt2FdtgkwUl5wvOEz",
        "Lji4QI4REDld1Y9NOhuRf"
      ],
      "frameId": null,
