      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Best alternative if boundary bursts must be prevented\nwithout high memory overhead",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "lXvLqweMsJoHRRS02eirj",
      "type": "text",
      "x": 3082.7013960701174,
      "y": 2966.736230001996,
      "width": 6.399993896484375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
