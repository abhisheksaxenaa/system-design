    },
    {
      "id": "FFmF7rxfTsKqG12EkFkE_",
      "type": "text",
      "x": 1932.4623198517652,
      "y": 2627.6886357856024,
      "width": 6.399993896484375,
      "height": 20,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b3E",
