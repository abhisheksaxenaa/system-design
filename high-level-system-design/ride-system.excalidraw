    {
      "id": "uwhXiZmEnUywr0GqrrJlA",
      "type": "text",
      "x": 3654.340573569389,
      "y": 3958.8036053761602,
      "width": 430.52764892578125,
      "height": 60,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0f",
      "roundness": null,
      "seed": 2053807979,
      "version": 186,
      "versionNonce": 102068541,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489207012,
      "link": null,
      "locked": false,
      "text": "Rather than keeping it outside the API gateway,\nkeeping it inside it, so to reduce the network overhead\nserialization cost and extra load balancer layers",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Rather than keeping it outside the API gateway,\nkeeping it inside it, so to reduce the network overhead\nserialization cost and extra load balancer layers",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Fav-VUUs7Yy7p-TGNmbMI",
      "type": "text",
      "x": 3529.522093140996,
      "y": 3783.6686881620876,
      "width": 133.24786376953125,
      "height": 40,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0g",
      "roundness": null,
      "seed": 622563211,
      "version": 198,
      "versionNonce": 623054099,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489251103,
      "link": null,
      "locked": false,
      "text": "putting this as\nlightweight plugin",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "putting this as\nlightweight plugin",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "kQJQH4vUyo_n32WcPUgQO",
      "type": "text",
      "x": 4384.369400748978,
      "y": 3132.924366501885,
      "width": 472.47955322265625,
      "height": 160,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "IuVs6i0u9gV805gzwa178"
      ],
      "frameId": null,
      "index": "b0p",
      "roundness": null,
      "seed": 900673515,
      "version": 372,
      "versionNonce": 2083406237,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489358319,
      "link": null,
      "locked": false,
      "text": "CHOICE A\nToken Bucket\nPro\n- allows traffic bursts (up to bucket capacity)\n- memory efficient (2 variables: tokens, last_updated)\n\nCons\nRace conditions in distributed system require lock mechanism",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE A\nToken Bucket\nPro\n- allows traffic bursts (up to bucket capacity)\n- memory efficient (2 variables: tokens, last_updated)\n\nCons\nRace conditions in distributed system require lock mechanism",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "E9ti40PaXbVFT8IrcQRmf",
      "type": "text",
      "x": 4384.369400748978,
      "y": 3302.082096333506,
      "width": 392.49566650390625,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "IuVs6i0u9gV805gzwa178"
      ],
      "frameId": null,
      "index": "b0q",
      "roundness": null,
      "seed": 1077766533,
      "version": 143,
      "versionNonce": 1443230387,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489836552,
      "link": null,
      "locked": false,
      "text": "Best Fit for general API rate limiting where short\nbursts are acceptable",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Best Fit for general API rate limiting where short\nbursts are acceptable",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "ulOe7o5KGF2lGeCBjyqyO",
      "type": "text",
      "x": 4383.4926080768155,
      "y": 3405.266697115941,
      "width": 584.447509765625,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "Ch6o34eDB-gF_z6Zn5Kt-"
      ],
      "frameId": null,
      "index": "b0r",
      "roundness": null,
      "seed": 1268292235,
      "version": 669,
      "versionNonce": 1804469757,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489466432,
      "link": null,
      "locked": false,
      "text": "CHOICE B\nLeaky Bucket\nPro\n- Smooths out traffic spikes\n- processes requests at a constant unifrm rate (great for egress traffic)\n\nCons\n- Can drop legitimate requests during temporary spikes if the queue fills up\n- adds queue delay",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE B\nLeaky Bucket\nPro\n- Smooths out traffic spikes\n- processes requests at a constant unifrm rate (great for egress traffic)\n\nCons\n- Can drop legitimate requests during temporary spikes if the queue fills up\n- adds queue delay",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "3zqJ3N1epBS6jEaESDrLw",
      "type": "text",
      "x": 4383.4926080768155,
      "y": 3591.348003981885,
      "width": 620.1434326171875,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "ZWeqvAIhHMDjMbguwypts",
        "Ch6o34eDB-gF_z6Zn5Kt-"
      ],
      "frameId": null,
      "index": "b0s",
      "roundness": null,
      "seed": 1836227269,
      "version": 313,
      "versionNonce": 1622877267,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489886714,
      "link": null,
      "locked": false,
      "text": "Better suited for background processing queues rather than synchronous APIs",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Better suited for background processing queues rather than synchronous APIs",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "NAo19EoFxeNfblbaPoqWJ",
      "type": "text",
      "x": 4377.660770569441,
      "y": 3648.6824457513685,
      "width": 470.17559814453125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "L5NEUhlchaKTSwdjNOhhH"
      ],
      "frameId": null,
      "index": "b0t",
      "roundness": null,
      "seed": 1061669259,
      "version": 1019,
      "versionNonce": 2000043613,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489551070,
      "link": null,
      "locked": false,
      "text": "CHOICE C\nFixed Window Counter\nPro\n- Extremely memory efficient\n- simple to implement (INCR with TTL in Redis)\n\nCons\n- Boundary Problem: can pass through at window boundaries\n(100 reqs at 11:59 and 100 at 12:00)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE C\nFixed Window Counter\nPro\n- Extremely memory efficient\n- simple to implement (INCR with TTL in Redis)\n\nCons\n- Boundary Problem: can pass through at window boundaries\n(100 reqs at 11:59 and 100 at 12:00)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "mMQnshGRAyQ1YKNKEHGYd",
      "type": "text",
      "x": 4377.660770569441,
      "y": 3841.792185010377,
      "width": 337.05572509765625,
      "height": 20,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "w43yMiO63sHIBYXPgExQC",
        "L5NEUhlchaKTSwdjNOhhH"
      ],
      "frameId": null,
      "index": "b0u",
      "roundness": null,
      "seed": 1605959851,
      "version": 253,
      "versionNonce": 1830363635,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489924531,
      "link": null,
      "locked": false,
      "text": "Too inaccurate for strict limit enforcement",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Too inaccurate for strict limit enforcement",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "IzP819YnPljF6eBsBa55n",
      "type": "text",
      "x": 4371.446104557487,
      "y": 3905.407065578403,
      "width": 533.4395141601562,
      "height": 200,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "Lji4QI4REDld1Y9NOhuRf"
      ],
      "frameId": null,
      "index": "b0v",
      "roundness": null,
      "seed": 1518187627,
      "version": 1287,
      "versionNonce": 1710779069,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489700970,
      "link": null,
      "locked": false,
      "text": "CHOICE D\nSliding Window Counter\nPro\n- On top of FWC with weighted averages\n- Highly accurate\n- memory efficient (2 counters per key)\n\nCons\n- Minor approximation edge cases (assumes uniform distribution over\npervious window)",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "CHOICE D\nSliding Window Counter\nPro\n- On top of FWC with weighted averages\n- Highly accurate\n- memory efficient (2 counters per key)\n\nCons\n- Minor approximation edge cases (assumes uniform distribution over\npervious window)",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "FADR4CXtZXI2Gtu6HCSdM",
      "type": "text",
      "x": 4371.446104557487,
      "y": 4121.4390341097815,
      "width": 429.6476135253906,
      "height": 40,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [
        "jZP4tt2FdtgkwUl5wvOEz",
        "Lji4QI4REDld1Y9NOhuRf"
      ],
      "frameId": null,
      "index": "b0w",
      "roundness": null,
      "seed": 1461719653,
      "version": 378,
      "versionNonce": 1680239507,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789489952469,
      "link": null,
      "locked": false,
      "text": "Best alternative if boundary bursts must be prevented\nwithout high memory overhead",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Best alternative if boundary bursts must be prevented\nwithout high memory overhead",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "RpY5C9WC556OM2g7Mpvfx",
      "type": "text",
      "x": 3651.2300497663346,
      "y": 3016.8414726409706,
      "width": 654.767333984375,
      "height": 260,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0y",
      "roundness": null,
      "seed": 1861493931,
      "version": 862,
      "versionNonce": 678824733,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789490057938,
      "link": null,
      "locked": false,
      "text": "Cache Eviction Policies:\nWhen using cache, one must have eviction policy configured\nvolatile-lru or volatile-ttl: Should have TTL set (matching the rate window length\n+ a buffer) if the cacher runs our of memory redis will only evict keys that have an \nexplicit expiration set\n\nNEVER USE allkeys-lru as it will evict the active keys and reset the counter\n\nStrategy:\n\n(rate:key_123:minute) with TTL matching the window duration\nonce the window expires, redis auto garbage collects\ninactive user consumes 0 bytes of memory outside their active traffic window",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Cache Eviction Policies:\nWhen using cache, one must have eviction policy configured\nvolatile-lru or volatile-ttl: Should have TTL set (matching the rate window length\n+ a buffer) if the cacher runs our of memory redis will only evict keys that have an \nexplicit expiration set\n\nNEVER USE allkeys-lru as it will evict the active keys and reset the counter\n\nStrategy:\n\n(rate:key_123:minute) with TTL matching the window duration\nonce the window expires, redis auto garbage collects\ninactive user consumes 0 bytes of memory outside their active traffic window",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "0HyL-LvGQLXlxGWX40auX",
      "type": "text",
      "x": 3646.1354064069697,
      "y": 3284.7927499295943,
      "width": 646.0634765625,
      "height": 100,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b0z",
      "roundness": null,
      "seed": 905385579,
      "version": 445,
      "versionNonce": 1243185459,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789490299827,
      "link": null,
      "locked": false,
      "text": "With TTL eviction and Token bucket algo how to execute calculation atomically \nwithout race condition between concurrent requests on same API key\n\nAs redis executes lua scripts single threaded on a given key's shard, the operation\nis non-blocking and completely race-condition-free",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "With TTL eviction and Token bucket algo how to execute calculation atomically \nwithout race condition between concurrent requests on same API key\n\nAs redis executes lua scripts single threaded on a given key's shard, the operation\nis non-blocking and completely race-condition-free",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "gD3WzM_fcJZy88spVG528",
      "type": "text",
      "x": 3052.8308973377843,
      "y": 3020.408060530574,
      "width": 538.6075439453125,
      "height": 280,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b10",
      "roundness": null,
      "seed": 1412810603,
      "version": 636,
      "versionNonce": 522231677,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789490503789,
      "link": null,
      "locked": false,
      "text": "Choosing Redis over memcached\nRedis-Pros \n- native lua scripting support. Allows executing multi-step \nlogic atomically on the server side in a single network round trip\n- Supports hashes\n- built-in key expiration (TTL)\n\nMemcached-Cons\n- Lack fo server-side logic\n- no complex data structure\n\nThere are others for scale like Valkey, KeyDB, ScyllaDB\n\nWe will use a Sharded Redis Cluster (or Valkey) running in each region",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Choosing Redis over memcached\nRedis-Pros \n- native lua scripting support. Allows executing multi-step \nlogic atomically on the server side in a single network round trip\n- Supports hashes\n- built-in key expiration (TTL)\n\nMemcached-Cons\n- Lack fo server-side logic\n- no complex data structure\n\nThere are others for scale like Valkey, KeyDB, ScyllaDB\n\nWe will use a Sharded Redis Cluster (or Valkey) running in each region",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "osaPGBWFq6-cSEciLOm1h",
      "type": "text",
      "x": 3029.3911407152877,
      "y": 4084.881169567726,
      "width": 580.6084922485043,
      "height": 480,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b11",
      "roundness": null,
      "seed": 2123796843,
      "version": 1290,
      "versionNonce": 1482220243,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789490864136,
      "link": null,
      "locked": false,
      "text": "Multi Region Synchronization Strategy:\n\nif a user makes requests in us-east and eu-west at the exact same\nsecond:\n\nOption A\nAll regional API gateways execute lua scripts against a single global redis\ncluser\n-> Single global cluster means increased latency and can go beyond\nrequired metrics\n-> Also Single Point of Failure\n\nOption B\nEach region run its own redis cluster and asynchronously sync counter\nupdates to other regions\n-> inconsistency in redis in case multiple requests go to different regions\n-> will go beyond the acceptable limit\n\nOption C\nToken reservation/partitoning: Allocate a quota split to each region\ndynamically (like 50% us-east and 50% eu-west)\n-> Dynamic Quota Partitioning avoids cross-region network round trips on\nthe critical request path\nby turning a global rate-limiting problem into localized sub-problems.",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Multi Region Synchronization Strategy:\n\nif a user makes requests in us-east and eu-west at the exact same second:\n\nOption A\nAll regional API gateways execute lua scripts against a single global redis cluser\n-> Single global cluster means increased latency and can go beyond required metrics\n-> Also Single Point of Failure\n\nOption B\nEach region run its own redis cluster and asynchronously sync counter updates to other regions\n-> inconsistency in redis in case multiple requests go to different regions\n-> will go beyond the acceptable limit\n\nOption C\nToken reservation/partitoning: Allocate a quota split to each region dynamically (like 50% us-east and 50% eu-west)\n-> Dynamic Quota Partitioning avoids cross-region network round trips on the critical request path\nby turning a global rate-limiting problem into localized sub-problems.",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "38tetVVwXgM5DZdC_jgQC",
      "type": "text",
      "x": 3638.9313744213337,
      "y": 4070.6035720840737,
      "width": 609.3918240745998,
      "height": 360,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#a5d8ff",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b12",
      "roundness": null,
      "seed": 49036715,
      "version": 754,
      "versionNonce": 540649437,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1789577882910,
      "created": 1789495255819,
      "link": null,
      "locked": false,
      "text": "Deep Dive on Option-C\nDynamic Quota Partitioning\n\nHow to divide percentage per region?\n-> A centralized manager (e.g., running alongside our Metadata DB) monitors\nglobal traffic patterns.\n\n-> Based on historical traffic or real-time metrics, it calculates each region's\nallocation percentage for a given API key.\n\nEach region’s Redis cluster receives its allocated batch of tokens/quota.\nwith zero cross-regional API calls\n\nThe percentage will be dynamic, syncing?\n-> The regional nodes report back to centralized manager and based on\nactual usage, reallocates to the relevant region\n-> if us-east is 60% and eu-west is on 40%, then unused from eu-west will\ngo back to us-east ",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Deep Dive on Option-C\nDynamic Quota Partitioning\n\nHow to divide percentage per region?\n-> A centralized manager (e.g., running alongside our Metadata DB) monitors global traffic patterns.\n\n-> Based on historical traffic or real-time metrics, it calculates each region's allocation percentage for a given API key.\n\nEach region’s Redis cluster receives its allocated batch of tokens/quota. with zero cross-regional API calls\n\nThe percentage will be dynamic, syncing?\n-> The regional nodes report back to centralized manager and based on actual usage, reallocates to the relevant region\n-> if us-east is 60% and eu-west is on 40%, then unused from eu-west will go back to us-east ",
      "autoResize": false,
      "lineHeight": 1.25,
      "labelPosition": null
    },
