    },
    {
      "id": "KOch8haDULchTR2WxsDtW",
      "type": "iframe",
      "x": 620.4220886230469,
      "y": 250.2109375,
      "width": 201.67990112304688,
      "height": 120,
      "angle": 0,
      "strokeColor": "transparent",
