    {
      "id": "z_EahkIeyk2rGMlCnPc1k",
      "type": "text",
      "x": 3549.889290123607,
      "y": 909.0348551308927,
      "width": 457.43963623046875,
      "height": 440,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "8Y-UF_F-uE5DHBL0ffLrW",
      "index": "b03V",
      "roundness": null,
      "seed": 95496378,
      "version": 743,
      "versionNonce": 1322782202,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789062647351,
      "created": 1789061454543,
      "link": null,
      "locked": false,
      "text": "FANOUT-on-READ\n\nUser X opens feed\n|\nGet X friends\n|\nGet posts from friends\n|\nMerge\n|\nRank\n\n\n\nPROs: Writes are cheap?\n\nProblem:\nRead aomplification.\nAlice follows 5k people, one request may touch thounsands\nof sources\n\nAt 600K requests becomes impossible to scale the reads",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FANOUT-on-READ\n\nUser X opens feed\n|\nGet X friends\n|\nGet posts from friends\n|\nMerge\n|\nRank\n\n\n\nPROs: Writes are cheap?\n\nProblem:\nRead aomplification.\nAlice follows 5k people, one request may touch thounsands\nof sources\n\nAt 600K requests becomes impossible to scale the reads",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "8Y-UF_F-uE5DHBL0ffLrW",
      "type": "frame",
      "x": 3507.8667191339855,
      "y": 870.1297210153579,
      "width": 576.0730363814234,
      "height": 541.445199663689,
      "angle": 0,
      "strokeColor": "#bbb",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
