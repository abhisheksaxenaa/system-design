      "boundElements": null,
      "updated": 1789062647351,
      "created": 1789061438578,
      "link": null,
      "locked": false,
      "name": "Fanout Strategy A"
    },
    {
      "id": "EKX8ptNV6Zup8wyaInnt5",
      "type": "text",
      "x": 4182.032773862667,
      "y": 908.5474757496974,
      "width": 489.6475830078125,
      "height": 460,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "F-ZAXeWNl2rTC3_pbYlmN",
      "index": "b05",
      "roundness": null,
      "seed": 1635125498,
      "version": 1057,
      "versionNonce": 1645500282,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789062647351,
      "created": 1789061601535,
      "link": null,
      "locked": false,
      "text": "FANOUT-on-WRITE\n\nUser A creates a post\n|\nFind followers\n|\nWrite postID into each followers feed\n\nUser X feed\n|\nFeed Store\n|\n20 post IDs\n|\nposts\n\nPROs: Fast Reads as we are reading from one user feed which\nis already upto date\n\nProblem:\nwhat if followers are 100M then writing into each 100M feed\n\nenormouse write amplification",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "FANOUT-on-WRITE\n\nUser A creates a post\n|\nFind followers\n|\nWrite postID into each followers feed\n\nUser X feed\n|\nFeed Store\n|\n20 post IDs\n|\nposts\n\nPROs: Fast Reads as we are reading from one user feed which\nis already upto date\n\nProblem:\nwhat if followers are 100M then writing into each 100M feed\n\nenormouse write amplification",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "F-ZAXeWNl2rTC3_pbYlmN",
      "type": "frame",
      "x": 4141.850271619814,
      "y": 866.9159806059439,
      "width": 576.0730363814234,
      "height": 541.445199663689,
      "angle": 0,
      "strokeColor": "#bbb",
      "backgroundColor": "transparent",
