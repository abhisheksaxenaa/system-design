    {
      "id": "t5c7e9MR2H2Lelh6d1WJN",
      "type": "text",
      "x": 1729.9594596118598,
      "y": -86.08659114449281,
      "width": 337.1517333984375,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "aC",
      "roundness": null,
      "seed": 265194214,
      "version": 452,
      "versionNonce": 2145644646,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789060794568,
      "created": 1789059238345,
      "link": null,
      "locked": false,
      "text": "500M daily active users\n\nFeed read QPS:\n20 feeds opens/user/day\n500M * 20 feeds = 10B feed requests/day\n\n~116K QPS\n\nAssume 5x peak: ~580QPS\n\nSo feed must support 600K requests\n\nWrite QPS:\n100M new posts/day\n\n~1160 posts/sec\n\nAssume 5x peak: ~6k posts/sec\n\nBig Difference in Writes/Read",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "500M daily active users\n\nFeed read QPS:\n20 feeds opens/user/day\n500M * 20 feeds = 10B feed requests/day\n\n~116K QPS\n\nAssume 5x peak: ~580QPS\n\nSo feed must support 600K requests\n\nWrite QPS:\n100M new posts/day\n\n~1160 posts/sec\n\nAssume 5x peak: ~6k posts/sec\n\nBig Difference in Writes/Read",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
