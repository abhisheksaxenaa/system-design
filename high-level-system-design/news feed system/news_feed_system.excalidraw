    },
    {
      "id": "buKjZDcPBmeuGon6mVgiS",
      "type": "text",
      "x": 4807.246743714982,
      "y": 902.8068211754286,
      "width": 524.41552734375,
      "height": 400,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": "gmQGvXcHK-qDwEz2mRbRy",
      "index": "b07",
      "roundness": null,
      "seed": 1640237542,
      "version": 1534,
      "versionNonce": 518799610,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1789062647351,
      "created": 1789061790967,
      "link": null,
      "locked": false,
      "text": "HYBRID\n\nDividing user bases into two parts (Normal & High Followers Users)\n\nNormal Users\n|\nFanout to follower feeds\n\nHigh Followers (Celebrity)\n|\nKeep post in author's timeline\n|\nMerge celebrity posts during feed read\n\n\nFor ordinary authors: cheap write x moderate followers\n\nFor celebrities: huge follower count x expensive fanout\n\nMake architecture distribution-aware",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "HYBRID\n\nDividing user bases into two parts (Normal & High Followers Users)\n\nNormal Users\n|\nFanout to follower feeds\n\nHigh Followers (Celebrity)\n|\nKeep post in author's timeline\n|\nMerge celebrity posts during feed read\n\n\nFor ordinary authors: cheap write x moderate followers\n\nFor celebrities: huge follower count x expensive fanout\n\nMake architecture distribution-aware",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
