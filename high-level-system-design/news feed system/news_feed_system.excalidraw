    {
      "id": "n9E8ccg6-FiFCwwZH3qJ_",
      "type": "text",
      "x": 973.0327143262733,
      "y": -108.77958433354303,
      "width": 433.69561767578125,
      "height": 340,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "a2",
      "roundness": null,
      "seed": 1081340262,
      "version": 567,
      "versionNonce": 2130801338,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1789059228694,
      "created": 1789053695607,
      "link": null,
      "locked": false,
      "text": "User should be able to:\n- Create a post\n- Delete own post\n- Edit own post\n- Post type? text, image, video?\n- Retrieve post feed\n    - See posts of relevant people/pages/groups\n    - Paginate through the feed\n- Posts Metadata:\n    - author, text/media, timestamp, engagement counts\n    - react or Comment on post\n\nFeed Generation Specific:\n- Identify contents from different sources\n- privacy/access control\n- rank content\n- return bounded page of results",
      "fontSize": 16,
      "baseFontSize": null,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "User should be able to:\n- Create a post\n- Delete own post\n- Edit own post\n- Post type? text, image, video?\n- Retrieve post feed\n    - See posts of relevant people/pages/groups\n    - Paginate through the feed\n- Posts Metadata:\n    - author, text/media, timestamp, engagement counts\n    - react or Comment on post\n\nFeed Generation Specific:\n- Identify contents from different sources\n- privacy/access control\n- rank content\n- return bounded page of results",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
